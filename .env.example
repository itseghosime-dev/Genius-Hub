# ==============================================================================
# Genius Hub Digital Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production credentials to version control.
#
# Variables are separated into:
# 1. Server-only variables (never exposed to browser client)
# 2. Public browser variables (prefixed with NEXT_PUBLIC_)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Canonical public site URL (Public browser variable)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Genius Hub"

# ------------------------------------------------------------------------------
# 2. DATABASE & PAYLOAD CMS (Active in Phase 02)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URI
DATABASE_URI=postgresql://postgres:postgrespassword@127.0.0.1:5432/genius_hub

# Payload CMS Secret Key (Generate a secure 32+ character random string in production)
PAYLOAD_SECRET=genius_hub_development_secret_key_minimum_32_chars_long

# ------------------------------------------------------------------------------
# 3. PLANNED FUTURE ENVIRONMENT CATEGORIES (Deferred to subsequent phases)
# ------------------------------------------------------------------------------
# The variables below outline the intended future architecture and are NOT required
# in Phase 02. They will be activated when their respective domains are introduced.

# --- REDIS / CACHE & RATE LIMITING ---
# REDIS_URL=redis://localhost:6379

# --- OBJECT STORAGE & CDN (Media & Image Archives) ---
# S3_BUCKET=genius-hub-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# NEXT_PUBLIC_CDN_URL=

# --- EMAIL (Amazon SES / Transactional Communications) ---
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# EMAIL_FROM="Genius Hub <noreply@geniushubglobal.com>"

# --- PAYMENTS (Paystack / Flutterwave / International Gateways) ---
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- AUTH & SECURITY ---
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# --- ANALYTICS & MONITORING ---
# NEXT_PUBLIC_ANALYTICS_ID=
# SENTRY_DSN=
